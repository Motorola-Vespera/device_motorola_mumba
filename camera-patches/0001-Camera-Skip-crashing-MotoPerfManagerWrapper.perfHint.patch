From 5bd274af1d8aa15d7109139a98f80f004652e893 Mon Sep 17 00:00:00 2001
From: zaraknyu <razenxizu@gmail.com>
Date: Fri, 4 Sep 2026 09:55:38 +0000
Subject: [PATCH] Camera: Skip crashing MotoPerfManagerWrapper.perfHintStart in
 onStop()
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

This perf hint is optional telemetry — skip it entirely.
---
 smali/com/motorola/camera/Camera.smali | 10 +---------
 1 file changed, 1 insertion(+), 9 deletions(-)

diff --git a/smali/com/motorola/camera/Camera.smali b/smali/com/motorola/camera/Camera.smali
index dc9c057..5c0c875 100644
--- a/smali/com/motorola/camera/Camera.smali
+++ b/smali/com/motorola/camera/Camera.smali
@@ -5226,15 +5226,7 @@
     invoke-static {v4, v5}, Landroid/util/Log;->d(Ljava/lang/String;Ljava/lang/String;)I
 
     :cond_e
-    sget-object v4, Lcom/motorola/camera/CameraApp;->sInstance:Lcom/motorola/camera/CameraApp;
-
-    invoke-static {v4}, Lmotorola/core_services/perf/MotoPerfManagerWrapper;->getInstance(Landroid/content/Context;)Lmotorola/core_services/perf/MotoPerfManagerWrapper;
-
-    move-result-object v4
-
-    const/16 v5, 0x77
-
-    invoke-virtual {v4, v5, v0, v2}, Lmotorola/core_services/perf/MotoPerfManagerWrapper;->perfHintStart(IILandroid/os/Bundle;)V
+    goto :cond_f
 
     :cond_f
     iget-object v0, p0, Lcom/motorola/camera/Camera;->mController:Lcom/motorola/camera/Controller;
